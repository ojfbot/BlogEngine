{
  "name": "@blogengine/rag-service",
  "version": "0.1.0",
  "description": "RAG and vector store integration for BlogEngine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./vectorstore/*": "./dist/vectorstore/*.js",
    "./embeddings/*": "./dist/embeddings/*.js",
    "./retrieval/*": "./dist/retrieval/*.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@blogengine/agent-core": "workspace:*",
    "@langchain/core": "^0.3.26",
    "@langchain/openai": "^0.3.14",
    "@langchain/community": "^0.3.21",
    "langchain": "^0.3.7",
    "@pinecone-database/pinecone": "^4.0.0",
    "chromadb": "^1.9.2",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
