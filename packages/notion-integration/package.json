{
  "name": "@blogengine/notion-integration",
  "version": "0.1.0",
  "description": "Notion API integration for BlogEngine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./client/*": "./dist/client/*.js",
    "./sync/*": "./dist/sync/*.js",
    "./schema/*": "./dist/schema/*.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@blogengine/agent-core": "workspace:*",
    "@notionhq/client": "^2.2.15",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
